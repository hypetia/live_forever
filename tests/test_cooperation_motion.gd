extends "res://tests/test_tactical_campaign.gd"
func care() -> Node2D:
 var game:=fresh()
 for actor: Survivor in game.survivors:game.self_care.set_enabled(game,actor,actor.survivor_id==1)
 game.survivors[0].health=55
 game.self_care.set_cooperation(game,game.survivors[1],'medical',true)
 game.select_survivor(2)
 return game
func _run() -> void:
 var game:=care();var med:int=game.inventory.amount('medicine');var actor:Survivor=game.survivors[1]
 advance(game,.1)
 expect(actor.self_care_kind=='aid' and not actor.route.is_empty(),'idle authorized medic physically approaches the stationary injured colleague')
 expect(game.selected_id==2 and game.survivors[0].health==55 and game.inventory.amount('medicine')==med,'medical planning neither steals control nor heals or spends remotely')
 valid(game,'medical approach')
 var pending:=SaveSystem.capture(game)
 expect(SaveSystem.apply_state(game,pending).is_empty(),'unfinished medical job restores with patient and route')
 advance(game,1)
 expect(game.survivors[0].health==55 and game.inventory.amount('medicine')==med,'travel and partial care do not award treatment')
 advance(game,15)
 expect(game.survivors[0].health>=85 and game.inventory.amount('medicine')==med-1,'arrival plus completed care uses the real medical outcome and pays once')
 expect(game.selected_id==2 and actor.person.last_aid>0,'aid is attributed to the actual medic without changing selection')
 var health:float=game.survivors[0].health;advance(game,5)
 expect(game.inventory.amount('medicine')==med-1 and game.survivors[0].health>=health,'medical cooldown prevents repeated charges')
 valid(game,'finished physical aid')
 game.free()
 game=care();advance(game,.1);game.select_survivor(1);game.move_selected(Vector2(500,430));advance(game,1)
 expect(game.self_care.members['xu']['aid'].is_empty() and game.inventory.amount('medicine')==2,'manual movement cancels unpaid medical approach')
 valid(game,'manual medical takeover');game.free()
 game=care();advance(game,.1);game.survivors[0].position=Vector2(600,430);advance(game,7)
 expect(game.inventory.amount('medicine')==2 and game.survivors[0].health<60,'moving a patient invalidates old care position instead of granting remote recovery')
 valid(game,'patient changed position');game.free()
 game=care();advance(game,.1);game.end_day()
 expect(game.self_care.members['xu']['aid'].is_empty() and game.inventory.amount('medicine')==2,'sunset clears unfinished medical jobs without payment')
 valid(game,'sunset support cancellation');game.free()
 game=fresh();game.chronicle.apply_scenario(game,'convoy')
 game.inventory.try_take({'meals':game.inventory.amount('meals')},'declared empty cooked-food fixture')
 for a: Survivor in game.survivors:game.self_care.set_enabled(game,a,a.survivor_id==0)
 game.survivors[1].hunger=85;game.survivors[2].hunger=80
 game.self_care.set_cooperation(game,game.survivors[0],'shared_cooking',true)
 var stock:Dictionary=game.inventory.snapshot();advance(game,.1)
 expect(game.survivors[0].orders==['cook'] and game.survivors[0].self_care_kind=='cook_shared','satiated cook prepares for hungry teammates with an explicit shared policy')
 expect(game.inventory.amount('meals')==0,'planning shared food creates no early meal')
 valid(game,'shared cooking approach')
 advance(game,20)
 expect(game.survivors[0].completed_by_task['cook']==1 and game.inventory.amount('meals')==3,'chef really reaches the stove and creates one paid three-meal batch')
 expect(game.inventory.amount('raw_food')==stock['raw_food']-1 and game.inventory.amount('water')==stock['water']-1 and game.inventory.amount('fuel')==stock['fuel']-1,'shared cooking conserves all three actual ingredients')
 expect(not game.survivors[0].orders.has('eat'),'the cook does not automatically consume a meal intended for others')
 valid(game,'completed shared batch');game.free()
 game=fresh();var store:=SaveSystem.new();store.path='res://tests/fixtures/v18_cooperation_upgrade_campaign.json';var read:=store.read_state()
 expect(read['ok'] and SaveSystem.apply_state(game,read['data']).is_empty(),'authentic schema18 unfinished autonomy migrates through the normal reader')
 expect(game.self_care.members.values().all(func(m):return not m['shared_cooking'] and not m['medical'] and m['aid'].is_empty()),'older saves never silently authorize extra fuel or medicine spending')
 valid(game,'schema18 migration');game.free()
 game=fresh();game.chronicle.apply_scenario(game,'infirmary')
 for a: Survivor in game.survivors:
  game.self_care.set_enabled(game,a,a.survivor_id!=2)
  if a.speciality=='医护':game.self_care.set_cooperation(game,a,'medical',true)
 game.survivors[2].health=55;advance(game,.1)
 expect(game.self_care.members.values().filter(func(m):return not m['aid'].is_empty()).size()==1,'two authorized doctors cannot double-book one patient')
 valid(game,'single medical reservation with two doctors');game.free()
 game=care();game.inventory.try_take({'medicine':1},'declared final medicine fixture');game.survivors[2].health=80;game.survivors[2].injury=20;game.select_survivor(2);game.assign_task('heal');advance(game,.1)
 expect(game.self_care.members['xu']['aid'].is_empty(),'autonomous aid cannot steal medicine promised to a manual healing order')
 valid(game,'manual medicine reservation');game.free()
 game=fresh();game.chronicle.apply_scenario(game,'convoy');game.inventory.try_take({'meals':game.inventory.amount('meals')},'declared emergency shared-food fixture')
 for a: Survivor in game.survivors:game.self_care.set_enabled(game,a,a.survivor_id==0)
 game.self_care.set_cooperation(game,game.survivors[0],'shared_cooking',true);game.survivors[1].hunger=85
 advance(game,.1);var batch:=SaveSystem.capture(game)
 expect(game.self_care.members['he']['action']=='cook_shared','explicitly authorized shared batch starts independently of the cook hunger')
 game.survivors[0].person.thirst=95;advance(game,.1)
 expect(not game.survivors[0].orders.has('cook') and game.self_care.members['he']['action']!='cook_shared','urgent thirst preempts an autonomous shared batch')
 expect(game.inventory.amount('fuel')==int(batch['stock']['fuel']),'interrupted unstarted shared work cannot burn fuel')
 valid(game,'emergency cooperation interruption');game.free()
 for weapon in ['knife','bat','spear','pistol']:
  var before:=CharacterMotion.pose('windup',1,1,1,weapon);var after:=CharacterMotion.pose('attack',1,0,1,weapon)
  expect(before['front'].distance_to(after['front'])<1 and absf(before['angle']-after['angle'])<.1,'weapon contact pose aligns with actual strike boundary: '+weapon)
 game=fresh();game.chronicle.apply_scenario(game,'convoy');game.inventory.try_take({'meals':game.inventory.amount('meals')},'declared everyone hungry fixture')
 for a: Survivor in game.survivors:game.self_care.set_enabled(game,a,a.survivor_id==0);a.hunger=92
 game.self_care.set_cooperation(game,game.survivors[0],'shared_cooking',true)
 advance(game,.1)
 expect(game.survivors[0].orders==['cook'],'a hungry authorized chef can prepare the shared food that also solves her own hunger')
 valid(game,'hungry shared-cook plan')
 advance(game,32)
 expect(game.survivors[0].completed_by_task['cook']==1 and game.survivors[0].completed_by_task['eat']==1,'critical hunger does not repeatedly cancel the shared meal needed to recover')
 expect(game.survivors[0].hunger<60 and game.inventory.amount('meals')==2,'chef eats via ordinary paid self-care after producing a single shared batch')
 valid(game,'hungry chef recovered without deadlock');game.free()
 game=fresh();game.chronicle.apply_scenario(game,'convoy');game.inventory.try_take({'meals':game.inventory.amount('meals')},'declared only chef hungry fixture')
 for a: Survivor in game.survivors:game.self_care.set_enabled(game,a,a.survivor_id==0)
 game.survivors[0].hunger=85;game.self_care.set_cooperation(game,game.survivors[0],'shared_cooking',true)
 advance(game,.1)
 expect(game.survivors[0].orders==['cook'],'shared food permission also covers the chef as a member of the team')
 advance(game,25)
 expect(game.survivors[0].completed_by_task['cook']==1 and game.survivors[0].completed_by_task['eat']==1,'a chef can feed herself under an existing shared cooking permission without another toggle')
 valid(game,'only chef hungry cooperation');game.free()
 # Deterministic visual poses must differ by action and phase without altering simulation.
 var idle:=CharacterMotion.pose('idle',0,0,1)
 for mode in ['walk','run','sneak','climb','search','door','window','vault','windup','attack','reload','hurt','eat','drink','aid','sleep']:
  var p:=CharacterMotion.pose(mode,.3,.35,1,'spear')
  expect(p!=idle,'distinct joint pose: '+mode)
  expect(p['head'].is_finite() and p['front'].is_finite() and p['left'].is_finite(),'finite local joints: '+mode)
 expect(CharacterMotion.pose('vault',0,0,1)['root'].y==0 and CharacterMotion.pose('vault',0,.5,1)['root'].y< -20,'vault anticipation and apex follow actual action progress')
 game=trip(false);var f:ExpeditionState=game.expedition;var enemy:Dictionary=f.enemies[0]
 for d in f.interior.doors:d['open']=true
 enemy['x']=600;enemy['floor']=0;enemy['target']=600;enemy['target_floor']=0;enemy['memory']=5;enemy['mode']='investigate'
 expect(EnemyMind.investigate(f,enemy,.1,false),'arriving at a last-known location starts a bounded investigation')
 var plan:Dictionary=f.minds[0]['search'].duplicate(true);f.player_x=1500
 EnemyMind.investigate(f,enemy,.1,false)
 expect(f.minds[0]['search']['destinations']==plan['destinations'],'moving the hidden player does not rewrite the remembered search route')
 for n in range(400):EnemyMind.investigate(f,enemy,.02,false)
 expect(f.minds[0]['search'].is_empty() and enemy['mode']=='patrol','unsuccessful search expires instead of chasing forever')
 enemy['x']=600;enemy['target']=600;enemy['memory']=5;enemy['mode']='investigate';EnemyMind.investigate(f,enemy,.1,false)
 EnemyMind.investigate(f,enemy,.1,true)
 expect(f.minds[0]['search'].is_empty(),'genuine new sight or sound replaces an old search plan')
 valid(game,'room investigation snapshot');game.free()
 expect(CharacterMotion.death_progress(0,true)==1.0,'the final casualty is lying down even when game over freezes simulation')
 expect(CharacterMotion.death_progress(.2,false)>.3 and CharacterMotion.death_progress(.2,false)<.4,'ordinary casualty falling retains its partial animation progress')
 print('COOPERATION MOTION RESULT: %d checks, %d failures' % [checks,failures]);quit(1 if failures else 0)
