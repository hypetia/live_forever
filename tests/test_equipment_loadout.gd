extends "res://tests/test_campaign.gd"

func _run() -> void:
	var g := campaign()
	g.expansion.grant("knife")
	g.expansion.grant("knife")
	g.expansion.gear[1]["durability"] = 31
	g.expansion.gear[2]["durability"] = 12
	var before: Dictionary = g.inventory.snapshot()
	expect(g.expansion.assign_gear(g,2,0) and g.expansion.assign_gear(g,3,1),"two additional knives can be given to different people")
	expect(g.survivors[0].weapon_item["id"]==2 and g.survivors[1].weapon_item["id"]==3 and g.survivors[2].weapon_item["id"]==1,"three identical knives retain three independent owners")
	expect(g.survivors[0].weapon_item["durability"]==31 and g.survivors[1].weapon_item["durability"]==12,"physical durability does not merge between identical weapons")
	expect(g.expansion.assign_gear(g,2,0) and g.survivors[0].weapon_item["id"]==2,"explicit same-owner assignment is idempotent")
	g.expansion.grant("vest")
	g.expansion.grant("coat")
	expect(g.expansion.assign_gear(g,4,0) and g.expansion.assign_gear(g,5,0),"armor and clothing occupy separate slots")
	expect(g.expansion.equipped_slots(g.survivors[0])==2,"coat does not reserve an extra backpack slot")
	expect(g.expansion.assign_gear(g,3,0),"a specific used knife can be transferred")
	expect(g.survivors[1].weapon_item.is_empty() and g.survivors[0].weapon_item["id"]==3 and g.expansion.gear[1]["owner"]=="","transfer clears source and returns only target previous weapon to warehouse")
	expect(g.survivors[0].armor_item["id"]==4 and g.survivors[0].coat_item["id"]==5,"weapon replacement preserves armor and clothing")
	var old: Array = g.expansion.gear.duplicate(true)
	expect(not g.expansion.assign_gear(g,999,0) and not g.expansion.assign_gear(g,2,99) and not g.expansion.assign_gear(g,2,-2) and g.expansion.gear==old,"invalid IDs cannot mutate equipment")
	valid(g,"multiple identical physical equipment save")
	var saved := SaveSystem.capture(g)
	var restored := campaign()
	expect(SaveSystem.apply_state(restored,saved).is_empty(),"load physical ownership and individual durability")
	expect(restored.survivors[0].weapon_item["id"]==3 and restored.survivors[2].weapon_item["id"]==1 and restored.expansion.gear[1]["owner"]=="","save restore keeps warehouse and every independent owner")
	expect(restored.survivors[0].weapon_item["durability"]==12,"loaded durability belongs to exact item")
	g.end_day()
	g.cycle.roles.assign(["scavenge","guard","floor"])
	expect(g.expansion.reserved_slots(g)==2,"night plan reserves equipped weapon and armor for chosen scavenger")
	expect(g.start_expedition(),"depart with new independent assignment")
	old=g.expansion.gear.duplicate(true)
	expect(not g.expansion.assign_gear(g,1,0) and not g.expansion.assign_gear(g,3,-1) and g.expansion.gear==old,"field inspection cannot access warehouse or unequip")
	expect(g.inventory.snapshot()==before,"equipping and departure without supplies do not fabricate or consume stock")
	valid(g,"departed physical loadout")
	g.free();restored.free()
	for region in FacilityArt.REGIONS:
		expect(Rect2(0,0,FacilityArt.TEXTURE.get_width(),FacilityArt.TEXTURE.get_height()).encloses(Rect2(region[0],region[1],region[2],region[3])),"authored facility region stays inside atlas")
	print("EQUIPMENT LOADOUT RESULT: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
