extends "res://tests/visual_campaign.gd"

func _run() -> void:
	var game: Node2D = load("res://scenes/campaign.tscn").instantiate()
	game.persistence_enabled = false
	root.add_child(game)
	game.set_process(false)
	await process_frame
	game.end_day()
	await keypress(KEY_ENTER)
	var field: ExpeditionState = game.expedition
	var actor: Survivor = game.survivors[field.actor_id]
	await click_at(game.world_offset()+Vector2(300,600)*game.world_scale())
	check(game.interface.target_site == 0 and game.interface.has_move_target,"clicking a distant crate starts a physical approach")
	check(not field.site_in_range(0) and not InteractionFeedback.site(game,0)["near"],"distant target is not falsely presented as in range")
	sim(game,1.3)
	check(field.site_in_range(0) and field.search_progress > 0 and not game._loot_open,"arrival transitions into an actual timed search")
	check(game.expedition_view.search_bar.visible and game.expedition_view.search_bar.value > 0,"actual progress control is visible above the searched object")
	check(game.expedition_view.search_bar.position.y < 750 and game.expedition_view.search_bar.size.y >= 7,"progress is large enough and stays out of the bottom HUD")
	check(not game.expedition_view.context_label.visible,"readiness does not add scene text labels")
	await picture("res://docs/v131-search.png")
	await keypress(KEY_SPACE)
	var progress := field.search_progress
	sim(game,0.5)
	check(field.search_progress == progress,"pause preserves visible search progress")
	await keypress(KEY_SPACE)
	sim(game,2)
	check(game._loot_open,"completed search opens the actual transfer window")
	await click_at(game.interface.loot_buttons["raw_food"].get_global_rect().get_center())
	await click_at(game.interface.loot_buttons["raw_food"].get_global_rect().get_center())
	check(InteractionFeedback.site(game,0)["supplied"],"remaining water keeps a partially looted container supplied")
	await click_at(game.interface.loot_buttons["water"].get_global_rect().get_center())
	check(not InteractionFeedback.site(game,0)["supplied"],"taking the last actual item immediately makes the container empty")
	await keypress(KEY_ESCAPE)
	await click_at(game.world_offset()+Vector2(360,610)*game.world_scale())
	sim(game,0.4)
	await picture("res://docs/v131-empty.png")
	check(InteractionFeedback.site(game,0)["body"] == InteractionFeedback.EMPTY_BODY,"fully emptied crate uses true neutral grey")
	check(not game.expedition_view.context_label.visible,"depleted state is conveyed without an empty-container sentence")
	# Reopen via the actual crate click; no second search is required.
	await click_at(game.world_offset()+Vector2(300,600)*game.world_scale())
	sim(game,0.5)
	check(game._loot_open,"a searched empty container remains accessible for putting things back")
	await click_at(game.interface.loot_returns["water"].get_global_rect().get_center())
	check(InteractionFeedback.site(game,0)["supplied"],"putting water back immediately restores the nonempty colour")
	await click_at(game.interface.loot_buttons["water"].get_global_rect().get_center())
	var home_stock: Dictionary = game.inventory.snapshot()
	var position_before := field.player_x
	await keypress(KEY_T)
	check(game.cycle.return_requested and not game._loot_open,"T is handled inside the loot window and starts return")
	check(field.player_x == position_before and game.inventory.snapshot() == home_stock,"return command does not teleport or remotely credit cargo")
	sim(game,0.3)
	check(field.player_x < position_before and field.active,"return visibly walks back toward extraction")
	await picture("res://docs/v131-return.png")
	await keypress(KEY_T)
	check(not game.cycle.return_requested,"T again cancels an optional return")
	await keypress(KEY_SPACE)
	check(not game.expedition_view.retreat_button.disabled,"paused return button remains actionable")
	await click_at(game.expedition_view.retreat_button.get_global_rect().get_center())
	check(game.cycle.return_requested and game.paused,"mouse return works while paused and preserves deliberate pause")
	await keypress(KEY_SPACE)
	sim(game,3)
	check(game.departure_dialog.visible and game.paused,"physical return pauses at departure confirmation")
	await keypress(KEY_ENTER)
	check(game.cycle.phase == "dawn" and not field.active,"real mouse/keyboard return reaches extraction and settles once")
	check(SaveSystem.validate(SaveSystem.capture(game)).is_empty(),"interactive return retains a valid persistent campaign")
	await dispose_scene(game)
	print("INTERACTIONS VISUAL RESULT: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
