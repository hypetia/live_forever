extends "res://tests/test_tactical_campaign.gd"

func _run() -> void:
 var game:=trip();var f:ExpeditionState=game.expedition;var actor:Survivor=game.survivors[f.actor_id]
 var def:Dictionary=f.site_definitions()[0]
 f.player_x=float(def['x'])-35;f.player_y=620;f.floor_level=0;f.facing=-1
 f.tick(.25,actor,{'interact':true})
 var progress:=f.search_progress
 expect(progress>0 and f.search_active and CharacterMotion.field_context(f,actor)['mode']=='search','an actual held search starts work and its animation')
 var context:=CharacterMotion.field_context(f,actor)
 expect(context['facing']==1 and f.facing==1,'the actual search command faces its object consistently with the next attack')
 var pose:=CharacterMotion.contact_pose(CharacterMotion.pose('search',0,.1,1),context)
 expect(absf(pose['front'].x-35)<.01,'the searching hand reaches the real nearby object')
 f.tick(.1,actor,{})
 expect(not f.search_active and f.search_progress==progress and CharacterMotion.field_context(f,actor)['mode']!='search','releasing use pauses progress and stops the false search animation')
 var snapshot:=SaveSystem.capture(game)
 expect(SaveSystem.apply_state(game,snapshot).is_empty() and not f.search_active and f.search_progress==progress,'restoring partial work never restores a held search input')
 var appearance:=InteractionFeedback.site(game,0)
 expect(appearance['opened']>0 and appearance['opened']<1,'an unlocked lid follows partial opening rather than remaining static')
 f._search(20,actor)
 expect(InteractionFeedback.site(game,0)['opened']==1 and f.loot_site==0,'a genuinely opened container remains physically open during transfer')
 for key in f.sites[0]['contents']:f.sites[0]['contents'][key]=0
 expect(InteractionFeedback.site(game,0)['supplied'],'typed food keeps container supplied after base resources are emptied')
 game.camp.food.open_cache(game);game.camp.food.caches[game.camp.food.cache_key(f,0)].clear()
 appearance=InteractionFeedback.site(game,0)
 expect(not appearance['supplied'] and appearance['opened']==1 and appearance['edge']==InteractionFeedback.EMPTY_EDGE,'last-item depletion leaves an open grey container without a stale coloured lid')
 valid(game,'searched container presentation');game.free()
 game=trip();f=game.expedition;actor=game.survivors[f.actor_id]
 var wall:float=InteriorState.layout(f.location_id)[0]['x'];f.player_x=wall-28;f.player_y=620;f.floor_level=0
 var completed:Array=[]
 f.interior.operation_finished.connect(func(kind,index,quiet):completed.append([kind,index,quiet]))
 f.tick(.02,actor,{'interact':true});f.tick(.3,actor,{})
 var opened:float=f.interior.visual_open(0)
 expect(opened>0 and opened<1 and not f.interior.doors[0]['open'],'door leaf visibly moves before the actual opening commits')
 expect(f.interior.barrier(f.location_id,wall-40,wall+40,0)==0 and completed.is_empty(),'animated opening cannot bypass collision or fire an early latch event')
 snapshot=SaveSystem.capture(game)
 for i in range(30):f.interior.visual_open(0)
 expect(SaveSystem.capture(game)==snapshot,'door animation sampling never changes collision, payment or saved progress')
 f.tick(.02,actor,{'axis':-1})
 expect(f.interior.action.is_empty() and f.interior.visual_open(0)==0 and completed.is_empty(),'movement cancels the door and its uncommitted opening without a success sound')
 f.tick(.01,actor,{});f.tick(.01,actor,{'interact':true})
 for i in range(80):f.tick(.02,actor,{})
 expect(f.interior.doors[0]['open'] and f.interior.visual_open(0)==1 and completed==[['door',0,false]],'a completed opening commits geometry and exactly one latch event')
 f.tick(.01,actor,{'interact':true});f.tick(.4,actor,{})
 expect(f.interior.visual_open(0)>0 and f.interior.visual_open(0)<1 and f.interior.doors[0]['open'],'closing animates from the existing open state')
 for i in range(80):f.tick(.02,actor,{})
 expect(not f.interior.doors[0]['open'] and completed.size()==2,'closing commits once instead of repeatedly toggling')
 var tools:int=f.bag['tools'];f.tick(.01,actor,{});f.tick(.01,actor,{'window':true})
 f.tick(.5,actor,{})
 expect(f.interior.action.get('quiet',false) and f.interior.doors[0]['window']==0 and f.bag['tools']==tools,'lifting a window in progress does not spend its tool or prematurely open it')
 for i in range(180):f.tick(.02,actor,{})
 expect(f.interior.doors[0]['window']==1 and f.bag['tools']==tools and actor.tool_item['durability']==92 and completed.back()==['window',0,true],'quiet window completion applies one durability charge to the actual reusable tool')
 valid(game,'completed door and window feedback');game.free()
 game=fresh()
 for a:Survivor in game.survivors:game.self_care.set_enabled(game,a,false)
 actor=game.survivors[0];actor.position=game.stove.work_position();game.select_survivor(0)
 var stock:Dictionary=game.inventory.snapshot();game.assign_task('cook');advance(game,.1)
 expect(game.stove.cooking_state().get('actor',-1)==0 and CharacterMotion.shelter_context(actor,game).get('stationary',false),'actual ordinary cooking drives the stove and stationary hand animation')
 var prep:=CharacterMotion.pose('cook',.2,.1,1,'',{'stationary':true})
 var stir:=CharacterMotion.pose('cook',.2,.5,1,'',{'stationary':true})
 var serve:=CharacterMotion.pose('cook',.2,.96,1,'',{'stationary':true})
 expect(prep['front'].y>stir['front'].y+10 and serve['front'].y>stir['front'].y+10,'preparation, stirring the real pot, and serving have distinct working heights')
 var clock:float=game.stove.animation_time;game.paused=true;game.stove._process(.5)
 expect(game.stove.animation_time==clock,'pause freezes stove steam and flames as well as the cooking task')
 game.paused=false;game.stove._process(.1)
 expect(game.stove.animation_time>clock,'stove animation resumes with the game')
 game.scheduler.cancel(actor)
 expect(game.stove.cooking_state().is_empty() and game.inventory.snapshot()==stock,'cancelled cooking clears flame/food activity and refunds the actual ingredients')
 actor.position=SurvivalExpansion.job_position('stove_2');game.select_survivor(0)
 expect(game.expansion.start_job(game,'stove_2'),'actual kitchen construction starts')
 advance(game,.5)
 expect(actor.activity.get('kind','')=='build' and game.stove.cooking_state().is_empty(),'an upgrade is construction rather than a false cooking flame')
 game.expansion.cancel(game,0)
 game.facilities.levels['stove']=2;game.facilities.sync(game)
 stock=game.inventory.snapshot()
 expect(game.expansion.start_job(game,'cook_batch'),'advanced kitchen batch starts with the existing paid recipe')
 advance(game,2)
 expect(actor.activity.get('kind','')=='cook' and game.stove.cooking_state().get('actor',-1)==0 and CharacterMotion.shelter_context(actor,game).get('stationary',false),'a real advanced recipe uses staged cooking rather than a hammering animation')
 expect(game.inventory.amount('raw_food')==int(stock['raw_food'])-2 and game.inventory.amount('meals')==int(stock['meals']),'visible batch preparation reserves real ingredients and grants no early meals')
 advance(game,15)
 expect(game.stove.cooking_state().is_empty() and game.inventory.amount('meals')==int(stock['meals'])+4,'advanced cooking completes the existing output once and clears the hot stove')
 valid(game,'ordinary and advanced kitchen animation');game.free()
 var material_ok:=true
 for id in LocationEnvironment.MAPS:
  for condition in [0,1]:
   for zone in LocationEnvironment.zones(id,condition):
    var x:float=(float(zone[0])+float(zone[1]))*.5
    material_ok=material_ok and LocationEnvironment.surface_kind(id,condition,x,int(zone[2]))==zone[3] and LocationEnvironment.surface(id,condition,x,int(zone[2]))==LocationEnvironment.SURFACES[zone[3]]
 expect(material_ok,'all nine maps use the same real surface zones for movement rules and visible/audible foot contacts')
 var motion:={'phase':1.2,'weight':1.0,'velocity':150.0}
 var moving_reload:=CharacterMotion.pose('reload',0,.4,1,'pistol',motion)
 var moving_walk:=CharacterMotion.pose('walk',0,.4,1,'pistol',motion)
 var standing_reload:=CharacterMotion.pose('reload',0,.4,1,'pistol')
 expect(moving_reload['left']==moving_walk['left'] and moving_reload['right']==moving_walk['right'],'moving reload preserves actual walking feet instead of sliding')
 expect(moving_reload['front']==standing_reload['front'] and moving_reload['back']==standing_reload['back'],'walking during reload cannot change its hand action or weapon timing')
 var feet:=SurfaceFootfalls.new()
 for i in range(100):feet.contact(Vector2(i*5,620),'water')
 expect(feet.marks.size()==SurfaceFootfalls.MAX_MARKS,'continuous walking has a bounded presentation budget')
 var marks:=feet.marks.duplicate(true);feet.step(0)
 expect(feet.marks==marks,'paused foot rings and dust cannot age')
 feet.step(.7)
 expect(feet.marks.is_empty(),'foot effects expire completely instead of accumulating through long play')
 var audio:=GameAudio.new();audio.persistent=false;root.add_child(audio)
 var sounds:Array=[]
 for kind in ['water','snow','metal','glass','wood','gravel']:
  var key:=SurfaceFootfalls.sound(kind)
  sounds.append(audio.sounds[key].data)
 expect(sounds.all(func(data):return sounds.count(data)==1),'six material footstep sounds are distinct cached waveforms')
 audio.free()
 print('SCENE POLISH RESULT: %d checks, %d failures'%[checks,failures]);quit(1 if failures else 0)
