extends "res://tests/visual_campaign.gd"

func _run() -> void:
	var game: Node2D = load("res://scenes/campaign.tscn").instantiate()
	game.persistence_enabled = false
	root.add_child(game)
	game.set_process(false)
	await process_frame
	await keypress(KEY_U)
	check(game.briefing.opened and game.paused,"U opens the optional briefing and pauses danger")
	check(game.briefing.offer_buttons.size() == 3,"three opportunities show distinct risks and rewards")
	check(game.briefing.window.get_global_rect().end.x <= 1440 and game.briefing.window.get_global_rect().end.y <= 900,"briefing fits the design viewport")
	var labels: Array = game.briefing.window.find_children("*","Label",true,false)
	check(labels.all(func(label): return label.get_theme_font_size("font_size") >= 17),"briefing body has no tiny text")
	await picture("res://docs/v15-briefing.png")
	await click_at(game.briefing.offer_buttons["meal_basic"].get_global_rect().get_center())
	check(game.director.contract == "meal_basic" and game.director.status == "active","actual offer button accepts exactly one objective")
	check(game.briefing.claim_button.disabled,"incomplete opportunity cannot be claimed")
	await keypress(KEY_ESCAPE)
	check(not game.briefing.opened and not game.paused and not game.center.visible,"Escape closes briefing and does not also open the main menu")
	for batch in range(2):
		await click_at(game.world_root.to_global(game.stove.position+Vector2(0,-118)))
		await click_at(game.interface.workshop_recipes["cook"].get_global_rect().get_center())
		sim(game,22)
	check(game.director.status == "ready" and game.inventory.amount("meals") == 4,"actual kitchen actions produce the required meals")
	await keypress(KEY_U)
	check(not game.briefing.claim_button.disabled,"completed food opportunity exposes the real supply exchange")
	await picture("res://docs/v15-objective-ready.png")
	var water: int = game.inventory.amount("water")
	await click_at(game.briefing.claim_button.get_global_rect().get_center())
	check(game.director.status == "claimed" and game.inventory.amount("water") == water+3 and game.inventory.amount("meals") == 0,"UI claim pays food and deposits the displayed supplies")
	check(game.briefing.offer_buttons.values().all(func(button): return button.disabled),"same-window replay cannot farm rewards")
	await keypress(KEY_ESCAPE)
	await keypress(KEY_K)
	await click_button(game.interface.workshop_panel,"工作台")
	check(game.interface.workshop_recipes["pistol"].disabled and game.interface.workshop_recipes["pistol"].get_parent().modulate == Color.WHITE,"locked recipe keeps readable text instead of dimming the whole card")
	check(game.interface.workshop_recipes["pistol"].get_theme_color("font_disabled_color") == GameUi.MUTED,"disabled controls use the readable shared palette")
	await picture("res://docs/v15-workshop.png")
	await keypress(KEY_ESCAPE)
	await keypress(KEY_H)
	check(game.residence_view.opened,"home panel uses the same navigation and styles")
	await picture("res://docs/v15-home.png")
	await keypress(KEY_ESCAPE)
	await keypress(KEY_P)
	check(game.center.visible and game.center.theme.default_font_size == 18,"people and handbook pages share readable typography")
	await picture("res://docs/v15-people.png")
	await keypress(KEY_ESCAPE)
	game.end_day()
	check(game.interface.plan_forecast.text.contains("℃") and game.interface.plan_forecast.text.contains("尸群"),"night planning shows weather and danger before departure")
	await picture("res://docs/v15-planning.png")
	await keypress(KEY_ENTER)
	await keypress(KEY_U)
	check(game.briefing.opened and game.paused and game.briefing.offer_buttons.values().all(func(button): return button.disabled),"night journal is readable but cannot accept a new objective remotely")
	await keypress(KEY_ESCAPE)
	check(game.expedition.active and not game.paused,"closing the night journal resumes the same expedition")
	check(SaveSystem.validate(SaveSystem.capture(game)).is_empty(),"complete interface sequence retains valid persistent state")
	await dispose_scene(game)
	print("DIRECTOR VISUAL RESULT: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
