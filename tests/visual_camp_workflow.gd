extends "res://tests/visual_campaign.gd"
## Real dispatched input; declared stock fixture is solely for construction coverage.

func right_click(point: Vector2) -> void:
	for down in [true,false]:
		var event:=InputEventMouseButton.new()
		event.position=point;event.global_position=point;event.button_index=MOUSE_BUTTON_RIGHT;event.pressed=down
		Input.parse_input_event(event);await process_frame

func _run() -> void:
	var output:String=OS.get_cmdline_user_args()[0]
	DirAccess.make_dir_recursive_absolute(output)
	var g:Node2D=load("res://scenes/campaign.tscn").instantiate()
	g.persistence_enabled=false;root.add_child(g);g.set_process(false)
	for actor:Survivor in g.survivors:g.self_care.set_enabled(g,actor,false)
	g.inventory.deposit({"materials":40,"tools":8,"fuel":8},"declared workflow construction fixture")
	g.camp.food.add({"meat":4,"vegetables":4,"dirty_water":8},1)
	await process_frame
	await keypress(KEY_SPACE)
	check(g.paused,"manual pause is active before browsing")
	await keypress(KEY_K);await keypress(KEY_ESCAPE)
	check(g.paused and not g.interface.workshop_open,"inspection restores an intentional manual pause")
	await keypress(KEY_K);await click_button(g.interface.workshop_panel,"厨房")
	check(g.interface.workshop_recipes.has("cook") and g.interface.workshop_recipes.has("balanced") and g.interface.workshop_recipes.has("dry_meat"),"one kitchen contains basic, fresh-food and preserved-food recipes")
	await picture(output+"/kitchen.png")
	await click_at(g.interface.workshop_recipes["cook"].get_global_rect().get_center())
	check(not g.paused and not g.interface.workshop_open and g.survivors[0].orders.has("cook"),"committing a meal from manual pause closes the panel and starts time automatically")
	sim(g,25)
	await keypress(KEY_F5)
	await click_at(g.camp_view.page_buttons["production"].get_global_rect().get_center())
	await click_at(g.camp_view.actions["category:kitchen"].get_global_rect().get_center())
	check(not g.camp_view.opened and g.interface.workshop_open and g.interface.workshop_section=="kitchen","camp's kitchen link opens the same screen without layering panels")
	await keypress(KEY_B)
	check(g.interface.workshop_section=="construction" and g.interface.workshop_recipes.has("bed"),"B switches directly from kitchen to visible bed construction")
	await picture(output+"/construction.png")
	await click_at(g.interface.workshop_recipes["bed"].get_global_rect().get_center())
	check(not g.interface.workshop_open and g.placement=="bed" and not g.paused,"choosing a bed closes the catalog and exposes placement")
	var materials:int=g.inventory.amount("materials")
	await click_at(g.world_root.to_global(CampaignCycle.SLOTS[1]-Vector2(0,25)))
	check(g.placement.is_empty() and g.cycle.builds.size()==1 and g.inventory.amount("materials")==materials-4,"a scene click starts one paid physical bed blueprint")
	sim(g,60)
	check(g.cycle.builds[0]["state"]=="complete" and g.cycle.bed_count()==2,"completed bed adds an actual night sleeping place")
	await keypress(KEY_SPACE);await keypress(KEY_B)
	await click_at(g.interface.workshop_recipes["bed"].get_global_rect().get_center())
	check(g.paused,"selecting a location alone preserves manual pause")
	await click_at(g.world_root.to_global(CampaignCycle.SLOTS[0]-Vector2(0,25)))
	check(not g.paused and g.cycle.builds.size()==2,"placing the second bed resumes from manual pause")
	sim(g,60);await keypress(KEY_B)
	check(g.interface.workshop_recipes["bed"].disabled and g.cycle.bed_count()==3,"bed limit is visibly disabled after two extra beds complete")
	await keypress(KEY_F5)
	check(g.camp_view.opened and not g.interface.workshop_open,"F5 switches directly to camp")
	await keypress(KEY_O)
	check(g.equipment_view.opened and not g.camp_view.opened,"O switches directly to equipment")
	await keypress(KEY_H)
	check(g.residence_view.opened and not g.equipment_view.opened,"H switches directly to home security and relocation")
	await keypress(KEY_Z)
	check(g.security_view.opened and not g.residence_view.opened,"security link cannot leave an invisible paused parent")
	await right_click(Vector2(700,300))
	check(CampaignPanels.current(g)==null and not g.paused,"right click returns from inspection to the original running game")
	await keypress(KEY_K)
	var orders:Array=g.survivors[0].orders.duplicate()
	await right_click(Vector2(400,300))
	check(not g.interface.workshop_open and g.survivors[0].orders==orders,"right-click dismissal never cancels the survivor's work")
	await keypress(KEY_K);await click_at(Vector2(12,12))
	check(not g.interface.workshop_open and not g.paused,"outside click dismisses and consumes the click")
	await keypress(KEY_SPACE);await keypress(KEY_K);await keypress(KEY_SPACE)
	check(CampaignPanels.current(g)==null and not g.paused,"Space closes inspection and explicitly resumes")
	await keypress(KEY_K)
	await click_at(g.interface.workshop_recipes["craft"].get_global_rect().get_center())
	sim(g,1)
	await keypress(KEY_K);await click_button(g.interface.workshop_panel,"生产计划")
	await click_at(g.interface.production_actions["craft"].get_global_rect().get_center())
	check(g.production.orders[0]["paused"] and g.interface.workshop_open,"pausing an order keeps its controls available")
	await click_at(g.interface.production_actions["craft"].get_global_rect().get_center())
	check(not g.interface.workshop_open and not g.paused and not g.production.orders[0]["paused"],"resuming an order also closes inspection and resumes time")
	sim(g,35)
	await keypress(KEY_K);await click_button(g.interface.workshop_panel,"饮水处理")
	check(g.interface.workshop_recipes.has("boil_water") and g.interface.workshop_recipes["filter_water"].disabled,"water page separates boilable stock from the unbuilt filter")
	var water:int=g.inventory.amount("water")
	await click_at(g.interface.workshop_recipes["boil_water"].get_global_rect().get_center());sim(g,35)
	check(not g.paused and g.inventory.amount("water")==water+3,"shared water command completes exact paid output")
	for resolution in [Vector2i(1024,768),Vector2i(1280,720),Vector2i(1920,1080)]:
		root.size=resolution;await process_frame;await keypress(KEY_B)
		check(g.interface.workshop_panel.get_global_rect().encloses(g.interface.workshop_recipes["bed"].get_global_rect()),"bed remains visible at "+str(resolution))
		await keypress(KEY_ESCAPE)
	root.size=Vector2i(1440,900);await process_frame
	check(SaveSystem.validate(SaveSystem.capture(g)).is_empty(),"completed work, beds and pause decisions remain saveable")
	g.end_day();await keypress(KEY_K);await keypress(KEY_SPACE)
	check(g.cycle.phase=="planning" and g.paused and not g.interface.workshop_open,"Space cannot auto-depart or advance night role assignment")
	await dispose_scene(g)
	print("CAMP WORKFLOW VISUAL RESULT: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
