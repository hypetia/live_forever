extends "res://tests/test_campaign.gd"

func fund(game: Node2D) -> void:
	game.inventory.deposit({"materials":80,"tools":12,"raw_food":12,"water":16,"fuel":12},"isolated facility fixture")

func _run() -> void:
	var game := campaign()
	fund(game)
	game.select_survivor(0)
	expect(game.facilities.snapshot() == {"workbench":1,"stove":1},"new facilities start at independent tier one")
	var before: Dictionary = game.inventory.snapshot()
	for kind in ["spear","vest","coat","pistol","ammo","cook_batch","cook_pot"]:
		expect(not game.expansion.start_job(game,kind) and game.inventory.snapshot() == before,"locked recipe cannot spend materials or start: "+kind)
	game.upkeep.integrity = 50
	expect(game.scheduler.submit(game.survivors[0],"repair"),"shelter repair remains a physical maintenance task")
	advance(game,20)
	expect(game.upkeep.integrity > 67 and game.facilities.levels["workbench"] == 1,"repair restores structure without secretly upgrading the workbench")
	expect(game.expansion.start_job(game,"workbench_2"),"upgrade starts through actual crafting action")
	expect(game.inventory.amount("materials") == before["materials"]-7 and game.inventory.amount("tools") == before["tools"]-1,"upgrade pays its exact materials and tool once")
	var paid: Dictionary = game.inventory.snapshot()
	expect(not game.expansion.start_job(game,"workbench_2") and game.inventory.snapshot() == paid,"duplicate upgrade cannot consume twice or cancel existing work")
	advance(game,3)
	expect(game.facilities.levels["workbench"] == 1 and not game.expansion.jobs.is_empty(),"arrival and partial work give no premature level")
	valid(game,"partial facility upgrade")
	game.cancel_selected()
	expect(game.inventory.amount("materials") == before["materials"]-1 and game.inventory.amount("tools") == before["tools"],"cancel returns unfinished upgrade inputs, not completed repair inputs")
	paid = game.inventory.snapshot()
	game.cancel_selected()
	expect(game.inventory.snapshot() == paid,"repeat cancellation cannot duplicate upgrade supplies")
	expect(game.expansion.start_job(game,"workbench_2"),"restart real workbench construction")
	game.select_survivor(1)
	expect(game.expansion.start_job(game,"stove_2"),"another survivor can upgrade the kitchen independently")
	advance(game,9)
	expect(game.expansion.jobs.size() == 2 and game.expansion.jobs.all(func(job): return job["elapsed"] > 0),"both stations advance independently rather than sharing one global queue")
	var snapshot := SaveSystem.capture(game)
	expect(SaveSystem.validate(snapshot).is_empty(),"parallel kitchen and workbench construction saves correctly")
	var store := SaveSystem.new()
	store.path = "user://facility_progress.json"
	expect(store.write_state(game)["ok"],"partial progress writes to real disk")
	var read := store.read_state()
	expect(read["ok"] and SaveSystem.apply_state(game,read["data"]).is_empty(),"same-schema load preserves both physical jobs")
	expect(game.facilities.levels["stove"] == 1 and game.expansion.jobs[1]["elapsed"] > 0,"load grants neither free level nor lost progress")
	game.paused = false
	advance(game,55)
	expect(game.facilities.snapshot() == {"workbench":2,"stove":2} and game.expansion.jobs.is_empty(),"paid physical construction completes both tier two facilities")
	expect(game.facility.tier == 2 and game.stove.tier == 2,"visible station tiers follow the authoritative state")
	expect(is_equal_approx(game.facilities.rate("stove"),1.15) and is_equal_approx(game.facilities.rate("workbench"),1.1),"tier two has distinct bounded kitchen and workshop speed bonuses")
	game.select_survivor(0)
	expect(not game.expansion.start_job(game,"pistol"),"tier two still cannot craft firearms")
	expect(game.expansion.start_job(game,"workbench_3"),"second workbench upgrade must be constructed normally")
	game.select_survivor(1)
	expect(game.expansion.start_job(game,"stove_3"),"second kitchen upgrade also has a real cost and duration")
	advance(game,80)
	expect(game.facilities.snapshot() == {"workbench":3,"stove":3},"both tier three upgrades complete")
	before = game.inventory.snapshot()
	expect(not game.expansion.start_job(game,"stove_3") and game.inventory.snapshot() == before,"max-level upgrade is rejected without spending anything")
	game.select_survivor(0)
	expect(game.expansion.start_job(game,"pistol"),"firearm crafting is now unlocked by the actual workbench")
	advance(game,48)
	expect(game.expansion.gear.any(func(item): return item["kind"] == "pistol"),"finished firearm appears only after work")
	expect(game.expansion.start_job(game,"ammo"),"advanced workbench also unlocks ammunition")
	advance(game,24)
	expect(game.expansion.ammo == 8,"ammo recipe grants exactly eight paid rounds")
	game.select_survivor(1)
	before = game.inventory.snapshot()
	expect(game.expansion.start_job(game,"cook_batch"),"tier two cooking recipe remains usable at tier three")
	expect(game.inventory.amount("raw_food") == before["raw_food"]-2 and game.inventory.amount("water") == before["water"]-2 and game.inventory.amount("fuel") == before["fuel"]-1,"combined cooking uses fewer fuel units, not free food")
	expect(game.inventory.amount("meals") == before["meals"],"queued cooking never credits meals remotely")
	advance(game,14)
	expect(game.inventory.amount("meals") == before["meals"]+4,"ordinary survivor receives exactly the displayed batch output")
	var chef := Survivor.new()
	chef.person.persona = "he"
	expect(FacilitySystem.cooking_output("cook_batch",chef)["meals"] == 6 and FacilitySystem.cooking_output("cook_stew",chef)["meals"] == 4 and FacilitySystem.cooking_output("cook_pot",chef)["meals"] == 8,"chef speciality affects each unlocked recipe consistently")
	chef.free()
	valid(game,"upgraded facilities, advanced output and old basic tasks")
	for bad_value in [0,4,1.5,"3"]:
		var bad := SaveSystem.capture(game)
		bad["facilities"]["stove"] = bad_value
		expect(not SaveSystem.validate(bad).is_empty(),"out-of-range or non-integer facility level is rejected")
	var bad := SaveSystem.capture(game)
	bad["facilities"].erase("stove")
	expect(not SaveSystem.validate(bad).is_empty(),"missing facility records cannot silently reset upgrades")
	expect(game.facilities.move_home(game) == 14 and game.facilities.snapshot() == {"workbench":1,"stove":1},"relocation salvages half paid materials and resets fixed facility tiers")
	game.free()

	game = campaign()
	fund(game)
	game.select_survivor(0)
	game.expansion.start_job(game,"stove_2")
	advance(game,7)
	before = game.inventory.snapshot()
	game.end_day()
	expect(game.facilities.levels["stove"] == 1 and game.expansion.jobs.is_empty(),"sunset cancels unfinished construction without awarding a level")
	expect(game.inventory.amount("materials") == before["materials"]+5 and game.inventory.amount("tools") == before["tools"]+1,"sunset refunds unfinished construction exactly")
	valid(game,"sunset construction refund")
	game.free()

	game = campaign()
	fund(game)
	game.facilities.levels["stove"] = 2
	game.facilities.sync(game)
	game.survivors[1].position = Vector2(900,430)
	game.survivors[0].position = Vector2(930,430)
	game.scheduler.submit(game.survivors[1],"cook")
	advance(game,0.1)
	game.select_survivor(0)
	expect(game.expansion.start_job(game,"cook_batch"),"advanced cooking can queue behind an existing ordinary meal")
	advance(game,1)
	expect(game.stove.occupant_id == 1 and game.expansion.jobs[0]["elapsed"] == 0,"one stove never advances ordinary and advanced cooking simultaneously")
	valid(game,"shared stove queue")
	advance(game,7)
	expect(game.stove.occupant_id == -1 and game.expansion.jobs[0]["elapsed"] > 0,"queued advanced recipe starts after the current cook releases the stove")
	advance(game,14)
	expect(game.expansion.jobs.is_empty() and game.inventory.amount("meals") == 6,"serialized cooking produces two plus four meals exactly once")
	game.free()

	game = campaign()
	store.path = "res://tests/fixtures/v10_workshop_job.json"
	read = store.read_state()
	expect(read["ok"] and read["migrated"],"genuine schema ten paid-firearm job migrates to schema eleven")
	expect(SaveSystem.apply_state(game,read["data"]).is_empty(),"legacy job and route remain valid after adding facility tiers")
	expect(game.facilities.levels["workbench"] == 1 and game.expansion.jobs[0]["kind"] == "pistol","old job survives without granting free facility upgrades")
	game.paused = false
	advance(game,55)
	expect(game.expansion.gear.any(func(item): return item["kind"] == "pistol") and game.expansion.jobs.is_empty(),"already-paid legacy job can finish at the original workbench")
	expect(not game.expansion.start_job(game,"pistol"),"starting another firearm still requires the new upgrade")
	valid(game,"legacy firearm completed without recharging its materials")
	game.free()
	print("FACILITIES RESULT: %d checks, %d failures" % [checks,failures])
	await create_timer(0.12).timeout
	quit(1 if failures else 0)
