extends "res://tests/visual_long_term.gd"


func choose_profile(scene: Node2D, expected: int) -> void:
	await dialog_click(scene.center, scene.center.roster_picker)
	var popup: PopupMenu = scene.center.roster_picker.get_popup()
	await click_at(Vector2(popup.position) + Vector2(popup.size.x * 0.5, (expected + 0.5) * popup.size.y / popup.item_count))
	check(scene.selected_id == expected, "actual profile dropdown selects member %d" % expected)


func _run() -> void:
	var scene: Node2D = load("res://scenes/shelter.tscn").instantiate()
	scene.persistence_enabled = false
	root.add_child(scene)
	scene.set_process(false)
	await process_frame
	await keypress(KEY_P)
	check(scene.center.visible and scene.center.tabs.current_tab == 5 and scene.paused, "P opens the actual paused people handbook")
	check(scene.center.roster_picker.item_count == 3 and not scene.center.routine_toggle.button_pressed and scene.center.recruit_button.disabled, "people page shows original profiles, default-off care and day1 recruitment restriction")
	await dialog_click(scene.center, scene.center.routine_toggle)
	check(scene.survivors[0].person.routine, "actual checkbox explicitly authorizes care for the selected member")
	await choose_profile(scene, 1)
	await dialog_click(scene.center, scene.center.routine_toggle)
	check(scene.survivors[1].person.routine, "second member receives independent authorization")
	await choose_profile(scene, 2)
	await dialog_click(scene.center, scene.center.routine_toggle)
	check(scene.survivors[2].person.routine, "third member receives independent authorization")
	await keypress(KEY_ESCAPE)
	await keypress(KEY_V)
	await dialog_click(scene.prep_dialog, scene.prep_dialog.get_ok_button())
	await held_key(KEY_D, true)
	simulate(scene, 1)
	await held_key(KEY_D, false)
	await held_key(KEY_E, true)
	simulate(scene, 1.8)
	await held_key(KEY_E, false)
	await held_key(KEY_A, true)
	simulate(scene, 1.1)
	await held_key(KEY_A, false)
	await keypress(KEY_T)
	check(scene.inventory.amount("raw_food") == 6 and scene.upkeep.returns["street"] == 1 and scene.survivors[2].person.experience["scout"] == 10, "real input trip earns supplies and actual exploration experience")
	# Bring back actual clinic water for cooking, drinking and the new recruit.
	await keypress(KEY_M)
	await dialog_click(scene.center, scene.center.map_buttons["clinic"])
	await dialog_click(scene.prep_dialog, scene.prep_dialog.get_ok_button())
	await held_key(KEY_D, true)
	simulate(scene, 1.3)
	await held_key(KEY_D, false)
	await held_key(KEY_E, true)
	simulate(scene, 2.6)
	await held_key(KEY_E, false)
	await held_key(KEY_A, true)
	simulate(scene, 1.4)
	await held_key(KEY_A, false)
	await keypress(KEY_T)
	check(scene.inventory.amount("water") == 8 and scene.upkeep.returns["clinic"] == 1, "second real trip supplies drinking and recruitment water")
	await keypress(KEY_1)
	await keypress(KEY_C)
	await keypress(KEY_C)
	await keypress(KEY_SPACE)
	simulate(scene, 25)
	check(scene.inventory.amount("tools") == 2 and scene.inventory.amount("materials") == 4, "real production prepares the upgrade without fixture goods")
	await keypress(KEY_M)
	scene.center.tabs.current_tab = 1
	await process_frame
	await dialog_click(scene.center, scene.center.upgrade_button)
	check(scene.upkeep.level == 1, "actual paid upgrade prepares living space")
	await keypress(KEY_ESCAPE)
	simulate(scene, 1200.2 - scene.simulation_time)
	check(scene.survivors.all(func(a): return a.health > 0 and a.person.thirst < 65), "authorized daily care uses real food, water and sleep across two calendar boundaries")
	await keypress(KEY_P)
	check(scene.center.candidate_picker.get_item_metadata(0) == "he" and not scene.center.recruit_button.disabled, "third-day visitor appears and can be paid with real supplies")
	var before: Dictionary = scene.inventory.snapshot()
	await dialog_click(scene.center, scene.center.recruit_button)
	check(scene.survivors.size() == 4 and scene.cards.size() == 4 and scene.survivors[3].display_name == "沈禾", "actual recruit button creates the distinct fourth survivor and card")
	check(scene.inventory.amount("raw_food") == before["raw_food"] - 2 and scene.inventory.amount("water") == before["water"] - 2 and scene.inventory.amount("medicine") == before["medicine"] - 1, "recruitment spends its complete real survival cost")
	check(scene.center.roster_picker.item_count == 4 and not scene.survivors[3].person.routine, "new member is selectable without silently enabling resource spending")
	await picture("res://docs/people-preview.png")
	await keypress(KEY_ESCAPE)
	await keypress(KEY_4)
	check(scene.selected_id == 3, "fourth survivor has a working real keyboard shortcut")
	await picture("res://docs/crew-preview.png")
	check(SaveSystem.validate(SaveSystem.capture(scene)).is_empty(), "complete real trip/care/recruitment UI run is a valid persistent state")
	scene.free()
	# Separate injury fixture verifies the medical button after the genuine-run screenshots.
	var clinical: Node2D = load("res://scenes/shelter.tscn").instantiate()
	clinical.persistence_enabled = false
	root.add_child(clinical)
	clinical.set_process(false)
	clinical.survivors[0].health = 40
	clinical.survivors[0].injury = 60
	clinical.survivors[0].infection = 45
	await keypress(KEY_2)
	await keypress(KEY_P)
	check(not clinical.center.aid_button.disabled, "medic's page offers actual paid aid for the injured selected companion")
	await dialog_click(clinical.center, clinical.center.aid_button)
	check(clinical.survivors[0].health == 60 and clinical.survivors[0].infection == 10 and clinical.inventory.amount("medicine") == 0 and clinical.survivors[1].person.experience["care"] == 8, "actual aid button consumes medicine, treats the companion and trains the medic")
	clinical.free()
	await create_timer(0.12).timeout
	print("PEOPLE VISUAL RESULT: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
