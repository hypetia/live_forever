extends "res://tests/visual_campaign.gd"

func _run() -> void:
	var game: Node2D = load("res://scenes/campaign.tscn").instantiate()
	game.persistence_enabled = false
	root.add_child(game); ArchiveFixture.campaign(game)
	game.set_process(false)
	game.inventory.deposit({"materials":60,"tools":10,"raw_food":10,"water":10,"fuel":10},"isolated GUI construction supplies")
	await process_frame
	await click_at(game.world_root.to_global(game.facility.position+Vector2(0,-118)))
	check(game.interface.workshop_open and game.paused,"clicking the physical workbench opens its paused facility page")
	check(game.interface.workshop_summary.text.contains("Lv.1"),"current station level is explicit")
	check(game.interface.workshop_recipes["pistol"].disabled and game.interface.workshop_recipes["ammo"].disabled,"firearms and ammunition are visibly locked at tier one")
	check(game.interface.workshop_recipes.has("repair_shelter"),"shelter maintenance has a separate named action")
	await picture("res://docs/v14-workbench.png")
	await click_at(game.interface.workshop_upgrade.get_global_rect().get_center())
	check(not game.interface.workshop_open and not game.paused and game.expansion.jobs.size() == 1,"upgrade click pays for a real job and resumes the world")
	check(game.facilities.levels["workbench"] == 1,"starting construction does not instantly increase the level")
	sim(game,8)
	await keypress(KEY_K)
	check(game.interface.workshop_upgrade.disabled and game.interface.workshop_upgrade.text.contains("施工中"),"partial upgrade displays progress and prevents duplicate orders")
	await keypress(KEY_ESCAPE)
	check(not game.interface.workshop_open and not game.paused,"Escape closes upgrade inspection without stopping construction")
	sim(game,48)
	check(game.facilities.levels["workbench"] == 2 and game.facility.tier == 2,"completed work changes the station and its visible model")
	await click_at(game.cards[1].get_global_rect().get_center())
	await click_at(game.world_root.to_global(game.stove.position+Vector2(0,-118)))
	check(game.interface.workshop_open and game.interface.workshop_section == "kitchen","physical stove opens kitchen recipes directly")
	check(game.interface.workshop_recipes["cook_batch"].disabled,"advanced cooking is locked before kitchen construction")
	await click_at(game.interface.workshop_upgrade.get_global_rect().get_center())
	sim(game,48)
	await click_at(game.world_root.to_global(game.stove.position+Vector2(0,-118)))
	check(not game.interface.workshop_recipes["cook_batch"].disabled and game.interface.workshop_recipes["cook_pot"].disabled,"tier two unlocks batch cooking but keeps the tier three recipe locked")
	await picture("res://docs/v14-kitchen.png")
	var meals: int = game.inventory.amount("meals")
	await click_at(game.interface.workshop_recipes["cook_batch"].get_global_rect().get_center())
	check(not game.interface.workshop_open and game.inventory.amount("meals") == meals,"recipe selection closes the drawer without prematurely awarding food")
	sim(game,18)
	check(game.inventory.amount("meals") == meals+4,"kitchen recipe delivers exactly the displayed output after physical work")
	await click_at(game.cards[0].get_global_rect().get_center())
	await click_at(game.world_root.to_global(game.facility.position+Vector2(0,-118)))
	await click_at(game.interface.workshop_upgrade.get_global_rect().get_center())
	sim(game,72)
	await keypress(KEY_K)
	check(game.interface.workshop_summary.text.contains("Lv.3") and not game.interface.workshop_recipes["pistol"].disabled,"tier three visibly unlocks handgun production")
	game.interface.workshop_scroll.ensure_control_visible(game.interface.workshop_recipes["pistol"])
	await process_frame
	await picture("res://docs/v14-firearms.png")
	await click_at(game.interface.workshop_recipes["pistol"].get_global_rect().get_center())
	check(game.expansion.jobs.any(func(job): return job["kind"] == "pistol"),"unlocked handgun button starts actual manufacturing")
	sim(game,48)
	check(game.expansion.gear.any(func(item): return item["kind"] == "pistol"),"manufactured handgun is stored after work completes")
	check(SaveSystem.validate(SaveSystem.capture(game)).is_empty(),"complete UI upgrade and cooking sequence is persistently valid")
	await dispose_scene(game)
	print("FACILITIES VISUAL RESULT: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
